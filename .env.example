# ----------------------------------------------------------------------------------
# Application properties
# ----------------------------------------------------------------------------------

APP_NAME=SafetyShield
APP_ENV=local
APP_KEY=
APP_URL=http://localhost:3000 #Should be Frontend Url
API_URL=http://box.localhost #Backendurl
GITHUB_REPO_URL=https://github.com/Safety-Shield/box
FRONTEND_URL="${APP_URL}"
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# ----------------------------------------------------------------------------------
# Logging & Debug configurations
# ----------------------------------------------------------------------------------

APP_DEBUG=false
# DEBUGBAR_ENABLED=true => force enabled
# DEBUGBAR_ENABLED=null => enabled if APP_DEBUG=true disabled otherwise
# DEBUGBAR_ENABLED=false => disabled
DEBUGBAR_ENABLED=null

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

BROADCAST_CONNECTION=null

# ----------------------------------------------------------------------------------
# Apiato Hashing feature
# ----------------------------------------------------------------------------------

HASH_ID=false
HASH_ID_KEY=s@f3ty-shield@!
HASH_ID_LENGTH=16

# ----------------------------------------------------------------------------------
# API configurations
# ----------------------------------------------------------------------------------

GLOBAL_API_RATE_LIMITER_ENABLED=true
GLOBAL_API_RATE_LIMITER_ATTEMPTS_PER_MIN=30
GLOBAL_API_RATE_LIMITER_EXPIRES_IN_MIN=1

PAGINATION_LIMIT_DEFAULT=10
PAGINATION_SKIP=false

API_TOKEN_EXPIRES=1440
API_REFRESH_TOKEN_EXPIRES=43200

ELOQUENT_QUERY_CACHE=false
ELOQUENT_QUERY_CACHE_TIME=60

# ----------------------------------------------------------------------------------
# AppSection Auth Configurations
# ----------------------------------------------------------------------------------

AUTHENTICATION_ENABLED=true
AUTHORIZATION_ENABLED=true
AUTH_REG_ENABLED=true
AUTH_GUARD=api
REQUIRE_PW_RESET=0

FIRST_ADMIN_EMAIL=superadmin@safetyshieldglobal.com
FIRST_ADMIN_PW=admin@123

CLIENT_WEB_ID=
CLIENT_WEB_SECRET=

BCRYPT_ROUNDS=12

# ----------------------------------------------------------------------------------
# MISC Configurations
# ----------------------------------------------------------------------------------

PHP_CLI_SERVER_WORKERS=4

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

MAIL_NOTIFICATIONS_DELAY=3

# ----------------------------------------------------------------------------------
# Database Env
# ----------------------------------------------------------------------------------

# Local Docker MySQL Image
DB_CONNECTION=mysql
DB_HOST=127.0.0.1 #use mysql-image in local docker environment
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=laravel
DB_PASSWORD=laravel
DB_SSL_MODE=DISABLED

# Local environment
# DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=apiato
# DB_USERNAME=root
# DB_PASSWORD=


# ----------------------------------------------------------------------------------
# Redis Cache / Queue
# ----------------------------------------------------------------------------------

REDIS_CLIENT=predis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
CACHE_PREFIX=

# Local Docker Redis
REDIS_HOST=redis-image
REDIS_PASSWORD=null
REDIS_PORT=6379
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# Local Environment
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379
# SESSION_DRIVER=database
# QUEUE_CONNECTION=database

# ----------------------------------------------------------------------------------
# S3 / MinIO & Docs configurations
# ----------------------------------------------------------------------------------

# Local (MinIO in Docker)
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=minio
AWS_SECRET_ACCESS_KEY=minio123
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=docker-bucket
AWS_ENDPOINT=http://localhost:9001
MAX_FILE_SIZE=10000 #10MB
DEFAULT_DIRECTORY='files'
AWS_USE_PATH_STYLE_ENDPOINT=true
MINIO_SERVICE_ALIAS=shield
TEMPORARY_URL_DURATION=5

# Local Dev environment
# FILESYSTEM_DISK=local

# ----------------------------------------------------------------------------------
# Cognito configurations
# ----------------------------------------------------------------------------------

COGNITO_AUTH_ACTIVE=true
COGNITO_INCLUDE_AUTH_ENDPOINTS=true
COGNITO_SYNC_USER_POOL_ACTIVE=true
COGNITO_SYNC_USER_DELETION=true # true if the user deletion should be reflected in the user pool.

COGNITO_USER_POOL_ID=
COGNITO_USER_POOL_NAME=ssg_user_pool
COGNITO_ENDPOINT=http://cognito:9229 # LEAVE IT EMPTY in production environment
COGNITO_VERSION=2016-04-18 # should be latest in production environment
# Optional: for custom endpoint (local) SDK uses AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY or dummy credentials
# COGNITO_ACCESS_KEY_ID=
# COGNITO_SECRET_ACCESS_KEY=

COGNITO_APP_CLIENT_ID=                     # Used if the laravel app will use AWS Cognito for authentication
COGNITO_APP_CLIENT_NAME=laravel_web_client # Used if the laravel app will use AWS Cognito for authentication
COGNITO_APP_CLIENT_SECRET=


# ----------------------------------------------------------------------------------
# SWAGGER API DOCS CONFIGURATIONS
# ----------------------------------------------------------------------------------

L5_SWAGGER_GENERATE_ALWAYS=true #can be true in dev to refresh docs on each request


# ----------------------------------------------------------------------------------
# COMPANY INFO DETAILS
# ----------------------------------------------------------------------------------

COMPANY_NAME='Safety Shield Global Limited'
COMPANY_ADRS_LINE1='Unity House'
COMPANY_ADRS_LINE2='Road Five, Winsford Industrial Estate'
COMPANY_ADRS_CITY='Winsford'
COMPANY_POSTAL_CODE='CW7 3RB'
COMPANY_PHONE='01606 210 340'
COMPANY_EMAIL='info@safetyshieldglobal.com'
COMPANY_SITE='www.safetyshieldglobal.com'
